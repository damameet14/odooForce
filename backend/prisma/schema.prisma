generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROCUREMENT_OFFICER
  FINANCE_OFFICER
  VENDOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLACKLISTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum RfqStatus {
  DRAFT
  SENT
  QUOTATIONS_RECEIVED
  UNDER_REVIEW
  APPROVAL_PENDING
  APPROVED
  REJECTED
  PO_GENERATED
  CLOSED
}

enum InviteStatus {
  INVITED
  VIEWED
  QUOTED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SELECTED
  REJECTED
  LOCKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum PoStatus {
  GENERATED
  SENT_TO_VENDOR
  ACKNOWLEDGED
  READY
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SHIPPED
  ON_THE_WAY
  DELIVERED
  RECEIVED
}

enum InvoiceStatus {
  GENERATED
  SENT
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model RoleDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  @@map("roles")
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           Role
  phone          String?
  status         UserStatus      @default(ACTIVE)
  vendor         Vendor?
  rfqs           Rfq[]           @relation("RfqCreator")
  approvalsMade  Approval[]      @relation("ApprovalRequester")
  approvalsSeen  Approval[]      @relation("ApprovalReviewer")
  purchaseOrders PurchaseOrder[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  deliveries     Delivery[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model VendorCategory {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @unique
  description      String?
  defaultGstPercent Decimal  @default(18) @map("default_gst_percent") @db.Decimal(5, 2)
  vendors          Vendor[]
  products         Product[]
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("vendor_categories")
}

model Product {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  categoryId    String         @map("category_id") @db.Uuid
  unit          String         @default("pieces")
  defaultGstPct Decimal        @default(18) @map("default_gst_pct") @db.Decimal(5, 2)
  status        ProductStatus  @default(ACTIVE)
  category      VendorCategory @relation(fields: [categoryId], references: [id])
  rfqItems      RfqItem[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("products")
}

model Vendor {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String?           @unique @map("user_id") @db.Uuid
  categoryId     String?           @map("category_id") @db.Uuid
  companyName    String            @map("company_name")
  contactPerson  String?           @map("contact_person")
  email          String
  phone          String?
  address        String?
  gstNumber      String?           @map("gst_number")
  status         VendorStatus      @default(ACTIVE)
  rating         Decimal           @default(0) @db.Decimal(3, 2)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  category       VendorCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invites        RfqVendorInvite[]
  rfqItemVendors RfqItemVendor[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  deliveries     Delivery[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("vendors")
}

model Rfq {
  id                   String            @id @default(uuid()) @db.Uuid
  rfqNumber            String            @unique @map("rfq_number")
  title                String
  description          String?
  createdBy            String            @map("created_by") @db.Uuid
  deadline             DateTime
  expectedDeliveryDate DateTime?         @map("expected_delivery_date") @db.Date
  status               RfqStatus         @default(DRAFT)
  creator              User              @relation("RfqCreator", fields: [createdBy], references: [id])
  items                RfqItem[]
  invites              RfqVendorInvite[]
  quotations           Quotation[]
  approvals            Approval[]
  purchaseOrders       PurchaseOrder[]
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@map("rfqs")
}

model RfqItem {
  id             String          @id @default(uuid()) @db.Uuid
  rfqId          String          @map("rfq_id") @db.Uuid
  productId      String?         @map("product_id") @db.Uuid
  itemName       String          @map("item_name")
  description    String?
  quantity       Decimal         @db.Decimal(12, 2)
  unit           String
  specifications String?
  deadline       DateTime?
  rfq            Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemVendors    RfqItemVendor[]
  quotationItems QuotationItem[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("rfq_items")
}

model RfqItemVendor {
  id        String       @id @default(uuid()) @db.Uuid
  rfqItemId String       @map("rfq_item_id") @db.Uuid
  vendorId  String       @map("vendor_id") @db.Uuid
  status    InviteStatus @default(INVITED)
  rfqItem   RfqItem      @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)
  vendor    Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([rfqItemId, vendorId])
  @@map("rfq_item_vendors")
}

model RfqVendorInvite {
  id        String       @id @default(uuid()) @db.Uuid
  rfqId     String       @map("rfq_id") @db.Uuid
  vendorId  String       @map("vendor_id") @db.Uuid
  status    InviteStatus @default(INVITED)
  invitedAt DateTime     @default(now()) @map("invited_at")
  rfq       Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor    Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
  @@map("rfq_vendor_invites")
}

model Quotation {
  id               String          @id @default(uuid()) @db.Uuid
  quotationNumber  String          @unique @map("quotation_number")
  rfqId            String          @map("rfq_id") @db.Uuid
  vendorId         String          @map("vendor_id") @db.Uuid
  deliveryDays     Int?            @map("delivery_days")
  deliveryTimeline String?         @map("delivery_timeline")
  paymentTerms     String?         @map("payment_terms")
  notes            String?
  subtotal         Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount   Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  grandTotal       Decimal         @default(0) @map("grand_total") @db.Decimal(12, 2)
  status           QuotationStatus @default(SUBMITTED)
  submittedAt      DateTime        @default(now()) @map("submitted_at")
  rfq              Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor           Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items            QuotationItem[]
  approvals        Approval[]
  purchaseOrders   PurchaseOrder[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([rfqId, vendorId])
  @@map("quotations")
}

model QuotationItem {
  id            String    @id @default(uuid()) @db.Uuid
  quotationId   String    @map("quotation_id") @db.Uuid
  rfqItemId     String    @map("rfq_item_id") @db.Uuid
  unitPrice     Decimal   @map("unit_price") @db.Decimal(12, 2)
  quantity      Decimal   @db.Decimal(12, 2)
  gstPercent    Decimal   @default(18) @map("gst_percent") @db.Decimal(5, 2)
  taxPercentage Decimal   @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount     Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal   @map("total_amount") @db.Decimal(12, 2)
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem       RfqItem   @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model Approval {
  id                  String         @id @default(uuid()) @db.Uuid
  rfqId               String         @map("rfq_id") @db.Uuid
  selectedQuotationId String?        @map("selected_quotation_id") @db.Uuid
  selectedItems       Json?          @map("selected_items")
  requestedBy         String         @map("requested_by") @db.Uuid
  reviewedBy          String?        @map("reviewed_by") @db.Uuid
  status              ApprovalStatus @default(PENDING)
  remarks             String?
  rfq                 Rfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  selectedQuotation   Quotation?     @relation(fields: [selectedQuotationId], references: [id], onDelete: Cascade)
  requester           User           @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  reviewer            User?          @relation("ApprovalReviewer", fields: [reviewedBy], references: [id])
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@map("approvals")
}

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  poNumber        String              @unique @map("po_number")
  rfqId           String              @map("rfq_id") @db.Uuid
  quotationId     String?             @map("quotation_id") @db.Uuid
  approvalId      String?             @map("approval_id") @db.Uuid
  vendorId        String              @map("vendor_id") @db.Uuid
  createdBy       String              @map("created_by") @db.Uuid
  status          PoStatus            @default(GENERATED)
  deliveryStatus  DeliveryStatus      @default(PENDING) @map("delivery_status")
  subtotal        Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  grandTotal      Decimal             @default(0) @map("grand_total") @db.Decimal(12, 2)
  termsConditions String?             @map("terms_conditions")
  rfq             Rfq                 @relation(fields: [rfqId], references: [id])
  quotation       Quotation?          @relation(fields: [quotationId], references: [id])
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  creator         User                @relation(fields: [createdBy], references: [id])
  items           PurchaseOrderItem[]
  delivery        Delivery?
  invoices        Invoice[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  itemName        String        @map("item_name")
  description     String?
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  gstPercent      Decimal       @default(18) @map("gst_percent") @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  purchaseOrderId String         @unique @map("purchase_order_id") @db.Uuid
  vendorId        String         @map("vendor_id") @db.Uuid
  status          DeliveryStatus @default(PENDING)
  notes           String?
  updatedBy       String         @map("updated_by") @db.Uuid
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  updater         User           @relation(fields: [updatedBy], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("deliveries")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique @map("invoice_number")
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  vendorId        String        @map("vendor_id") @db.Uuid
  status          InvoiceStatus @default(GENERATED)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  grandTotal      Decimal       @default(0) @map("grand_total") @db.Decimal(12, 2)
  dueDate         DateTime?     @map("due_date") @db.Date
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  items           InvoiceItem[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  itemName    String  @map("item_name")
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  gstPercent  Decimal @default(18) @map("gst_percent") @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  description String?
  metadata    Json?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  type      String?
  isRead    Boolean  @default(false) @map("is_read")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  mimeType   String?  @map("mime_type")
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

model EmailLog {
  id             String    @id @default(uuid()) @db.Uuid
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  recipientEmail String    @map("recipient_email")
  subject        String?
  status         String    @default("PENDING")
  errorMessage   String?   @map("error_message")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("email_logs")
}
